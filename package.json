{
  "name": "@local/dsh-frp",
  "version": "0.1.0",
  "private": true,
  "description": "Expose the local DSH Web GUI to the public internet through your own frps server, behind an authenticated gateway.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "gateway.js",
    "gateway-session.js",
    "header-rules.js",
    "frpc-config.js",
    "frpc-manager.js",
    "status-routes.js",
    "client.js",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
