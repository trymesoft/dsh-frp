{
  "name": "dsh-frp",
  "version": "0.1.0",
  "description": "Expose the local DeepSeek Harness Web GUI through your own frps server, behind an authenticated gateway.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "frp",
    "frps",
    "tunnel",
    "reverse-proxy",
    "remote-access",
    "self-hosted"
  ],
  "homepage": "https://github.com/trymesoft/dsh-frp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trymesoft/dsh-frp.git"
  },
  "bugs": {
    "url": "https://github.com/trymesoft/dsh-frp/issues"
  },
  "author": "trymesoft",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js && node --check src/client.js && node --check src/gateway.js && node --check src/gateway-session.js && node --check src/header-rules.js && node --check src/frpc-config.js && node --check src/frpc-manager.js && node --check src/status-routes.js && node --test test/*.test.js",
    "prepack": "npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
